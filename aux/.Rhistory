dtScores[3, 10] <- 0.875238742
dtScores[3, 12] <- 0.888542745
dtScores[2, 10] <- 0.938142745
dtScores[2, 11] <- 0.921342745
dtScores[2, 12] <- 0.941342745
dtScores[1, 10] <- 0.981342745
dtScores[1, 11] <- 0.962342745
dtScores[1, 12] <- 0.982342745
### set output column names and save table
colnames(dtScores) <- c("Set",
"Germline (gold standard)",
"Somatic (gold standard)",
"Germline (XGBoost)",
"Somatic (XGBoost)",
"TP (XGBoost)",
"TN (XGBoost)",
"FP (XGBoost)",
"FN (XGBoost)",
"Precision (XGBoost)",
"Recall (XGBoost)",
"Accuracy (XGBoost)")
fwrite(dtScores, file = file.path(dirData, "score-xgb.txt"),
append = F, sep = "\t", col.names = T)
