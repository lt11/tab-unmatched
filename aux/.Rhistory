## header ---------------------------------------------------------------------
library(data.table)
library(ggplot2)
library(this.path)
library(scriptName)
## settings -------------------------------------------------------------------
### main directory
dirBase <- dirname(this.dir())
### input directory
dirData <- file.path(dirBase, "res")
### output table and plot folder
dtScores <- data.table()
dirPlot <- file.path(dirBase, "plot")
if (!dir.exists(dirPlots)) {
dir.create(dirPlots)
}
## header ---------------------------------------------------------------------
library(data.table)
library(ggplot2)
library(this.path)
library(scriptName)
## settings -------------------------------------------------------------------
### main directory
dirBase <- dirname(this.dir())
### input directory
dirData <- file.path(dirBase, "res")
### output table and plot folder
dtScores <- data.table()
dirPlot <- file.path(dirBase, "plots")
if (!dir.exists(dirPlots)) {
dir.create(dirPlots)
}
## header ---------------------------------------------------------------------
library(data.table)
library(ggplot2)
library(this.path)
library(scriptName)
## settings -------------------------------------------------------------------
### main directory
dirBase <- dirname(this.dir())
### input directory
dirData <- file.path(dirBase, "res")
### output table and plot folder
dtScores <- data.table()
dirPlots <- file.path(dirBase, "plots")
if (!dir.exists(dirPlots)) {
dir.create(dirPlots)
}
### data sets
strSets <- c("train", "validation", "test")
## clmnt ----------------------------------------------------------------------
### script name
myName <- current_filename()
cat("[", myName, "] ",
"Starting the analysis to assess the performance.",
"\n", sep = "")
for (indL in strSets) {
### read predicted data, only file indL, get the full path
pathInPred <- list.files(dirData, pattern = paste0("preds-", indL),
full.names = T)
### check if file exists
if (length(pathInPred) == 0) {
cat("[", myName, "] ",
indL, " not found.", "\n", sep = "")
next
}
### read data
dtPred <- fread(pathInPred)
### explore the data with head()
head(dtPred)
### initialise a row with the number
### of germline and somatic in truth labels
oneRow <- c(indL)
nGermline <- length(which(dtPred$target == 0))
nSomatic <- length(which(dtPred$target == 1))
oneRow <- cbind(oneRow, nGermline, nSomatic)
### target = 1 -> somatic, target = 0 -> germline
nG <- length(which(dtPred$xgm_preds == "germline")) ### number of germline predicted by xgboost
nS <- length(which(dtPred$xgm_preds == "somatic")) ### number of somatic predicted by xgboost
nTP <- length(which(dtPred$target == 1
& dtPred$xgm_preds == "somatic")) ### number of true positives, i.e. somatic correctly predicted as somatic
nFN <- length(which(dtPred$target == 1
& dtPred$xgm_preds == "germline")) ### number of false negatives, i.e. somatic incorrectly predicted as germline
nTN <- length(which(dtPred$target == 0
& dtPred$xgm_preds == "germline")) ### number of true negatives, i.e. germline correctly predicted as germline
nFP <- length(which(dtPred$target == 0
& dtPred$xgm_preds == "somatic")) ### number of false positives, i.e. germline incorrectly predicted as somatic
valPrec <- nTP / (nTP + nFP) ### precision, i.e. of all the variants predicted as somatic, how many are actually somatic
valReca <- nTP / (nTP + nFN) ### recall, i.e. of all the somatic variants, how many are correctly predicted as somatic
valAcc <- (nTP + nTN) / (nTP + nTN + nFP + nFN) ### accuracy, i.e. of all the variants, how many are correctly predicted
oneRow <- c(oneRow, nG, nS, nTP, nTN, nFP, nFN,
valPrec, valReca, valAcc) ### append the metrics to the row
## append the row -----------------------------------------------------------
dtScores <- rbindlist(list(dtScores, as.data.table(as.list(oneRow))),
use.names = F, fill = T)
}
## header ---------------------------------------------------------------------
library(data.table)
library(ggplot2)
library(this.path)
library(scriptName)
## settings -------------------------------------------------------------------
### main directory
dirBase <- dirname(this.dir())
### input directory
dirData <- file.path(dirBase, "res")
### output table and plot folder
dtScores <- data.table()
dirPlots <- file.path(dirBase, "plots")
if (!dir.exists(dirPlots)) {
dir.create(dirPlots)
}
### data sets
strSets <- c("train", "validation")
## clmnt ----------------------------------------------------------------------
### script name
myName <- current_filename()
cat("[", myName, "] ",
"Starting the analysis to assess the performance.",
"\n", sep = "")
for (indL in strSets) {
### read predicted data, only file indL, get the full path
pathInPred <- list.files(dirData, pattern = paste0("preds-", indL),
full.names = T)
### check if file exists
if (length(pathInPred) == 0) {
cat("[", myName, "] ",
indL, " not found.", "\n", sep = "")
next
}
### read data
dtPred <- fread(pathInPred)
### explore the data with head()
head(dtPred)
### initialise a row with the number
### of germline and somatic in truth labels
oneRow <- c(indL)
nGermline <- length(which(dtPred$target == 0))
nSomatic <- length(which(dtPred$target == 1))
oneRow <- cbind(oneRow, nGermline, nSomatic)
### target = 1 -> somatic, target = 0 -> germline
nG <- length(which(dtPred$xgm_preds == "germline")) ### number of germline predicted by xgboost
nS <- length(which(dtPred$xgm_preds == "somatic")) ### number of somatic predicted by xgboost
nTP <- length(which(dtPred$target == 1
& dtPred$xgm_preds == "somatic")) ### number of true positives, i.e. somatic correctly predicted as somatic
nFN <- length(which(dtPred$target == 1
& dtPred$xgm_preds == "germline")) ### number of false negatives, i.e. somatic incorrectly predicted as germline
nTN <- length(which(dtPred$target == 0
& dtPred$xgm_preds == "germline")) ### number of true negatives, i.e. germline correctly predicted as germline
nFP <- length(which(dtPred$target == 0
& dtPred$xgm_preds == "somatic")) ### number of false positives, i.e. germline incorrectly predicted as somatic
valPrec <- nTP / (nTP + nFP) ### precision, i.e. of all the variants predicted as somatic, how many are actually somatic
valReca <- nTP / (nTP + nFN) ### recall, i.e. of all the somatic variants, how many are correctly predicted as somatic
valAcc <- (nTP + nTN) / (nTP + nTN + nFP + nFN) ### accuracy, i.e. of all the variants, how many are correctly predicted
oneRow <- c(oneRow, nG, nS, nTP, nTN, nFP, nFN,
valPrec, valReca, valAcc) ### append the metrics to the row
## append the row -----------------------------------------------------------
dtScores <- rbindlist(list(dtScores, as.data.table(as.list(oneRow))),
use.names = F, fill = T)
}
